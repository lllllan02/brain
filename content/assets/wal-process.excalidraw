550, "width": 15.659999999999998, "height": 35.1, "angle": 0, "strokeColor": "#b45309", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "seed": 124, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "?", "originalText": "?", "fontSize": 27, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.3}, {"id": "e25", "type": "text", "x": 245, "y": 603, "width": 198, "height": 28.6, "angle": 0, "strokeColor": "#b91c1c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "seed": 125, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "日志持久化之前断电", "originalText": "日志持久化之前断电", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.3}, {"id": "e26", "type": "text", "x": 245, "y": 641, "width": 304, "height": 49.4, "angle": 0, "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "seed": 126, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "修改仍可能丢失。\n同步持久化提交此时不应确认成功。", "originalText": "修改仍可能丢失。\n同步持久化提交此时不应确认成功。", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.3}, {"id": "e27", "type": "text", "x": 715, "y": 603, "width": 330, "height": 28.6, "angle": 0, "strokeColor": "#047857", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "seed": 127, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "日志已落盘、数据页未写回时断电", "originalText": "日志已落盘、数据页未写回时断电", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.3}, {"id": "e28", "type": "text", "x": 715, "y": 641, "width": 342, "height": 49.4, "angle": 0, "strokeColor": "#374151", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "seed": 128, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "内存丢失，但已提交的 120 可恢复。\n无需为确认成功，立刻写回所有数据页。", "originalText": "内存丢失，但已提交的 120 可恢复。\n无需为确认成功，立刻写回所有数据页。", "fontSize": 19, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.3}, {"id": "e29", "type": "text", "x": 25, "y": 729, "width": 792, "height": 28.6, "angle": 0, "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "seed": 129, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "收益来自：先付出日志顺序追加与同步的成本，保留脏页延后、批量写回的空间。", "originalText": "收益来自：先付出日志顺序追加与同步的成本，保留脏页延后、批量写回的空间。", "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.3}, {"id": "e30", "type": "text", "x": 25, "y": 775, "width": 850, "height": 22.1, "angle": 0, "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "seed": 130, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "示意不按时间比例绘制。假设数据页延后写回、无其他恢复副本、持久存储完好；不表示每次刷脏都比刷日志慢。", "originalText": "示意不按时间比例绘制。假设数据页延后写回、无其他恢复副本、持久存储完好；不表示每次刷脏都比刷日志慢。", "fontSize": 17, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.3}], "appState": {"viewBackgroundColor": "#ffffff"}, "files": {}}