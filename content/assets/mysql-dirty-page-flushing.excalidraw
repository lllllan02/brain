      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.35,
      "autoResize": false
    },
    {
      "id": "e100",
      "type": "text",
      "x": 30,
      "y": 1084,
      "width": 1460,
      "height": 24.3,
      "angle": 0,
      "strokeColor": "#64748b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.7,
      "strokeStyle": "solid",
      "roughness": 0,
