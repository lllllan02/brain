.4, "autoResize": true}, {"type": "text", "id": "e123", "x": 1250, "y": 678, "width": 193.38, "height": 47.599999999999994, "angle": 0, "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 954301, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "B 结束并释放文件，\n且有名额时，E 才启动。", "originalText": "B 结束并释放文件，\n且有名额时，E 才启动。", "fontSize": 17, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.4, "autoResize": true}, {"type": "text", "id": "e124", "x": 1058, "y": 803, "width": 328, "height": 25.2, "angle": 0, "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 320421, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "不用等无关调用；每次条件变化都重查。", "originalText": "不用等无关调用；每次条件变化都重查。", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.4, "autoResize": true}, {"type": "text", "id": "e125", "x": 428, "y": 905, "width": 274, "height": 25.2, "angle": 0, "strokeColor": "#1e40af", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 680871, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "容易理解和控制；可能空等慢调用", "originalText": "容易理解和控制；可能空等慢调用", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.4, "autoResize": true}, {"type": "text", "id": "e126", "x": 1058, "y": 905, "width": 292, "height": 25.2, "angle": 0, "strokeColor": "#047857", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 879996, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "减少无关等待；需持续维护运行状态", "originalText": "减少无关等待；需持续维护运行状态", "fontSize": 18, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.4, "autoResize": true}, {"type": "line", "id": "e127", "x": 30, "y": 959, "width": 1600, "height": 0, "angle": 0, "strokeColor": "#e2e8f0", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 927859, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "points": [[0, 0], [1600, 0]], "startBinding": null, "endBinding": null, "startArrowhead": null, "endArrowhead": null}, {"type": "text", "id": "e128", "x": 30, "y": 982, "width": 739, "height": 29.4, "angle": 0, "strokeColor": "#1e3a5f", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 206457, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "依赖决定先后，冲突限制重叠，容量限制数量。两种策略都必须满足这些约束。", "originalText": "依赖决定先后，冲突限制重叠，容量限制数量。两种策略都必须满足这些约束。", "fontSize": 21, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.4, "autoResize": true}, {"type": "text", "id": "e129", "x": 30, "y": 1021, "width": 786, "height": 23.799999999999997, "angle": 0, "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1.5, "strokeStyle": "solid", "roughness": 0, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 119532, "version": 1, "versionNonce": 1, "isDeleted": false, "boundElements": null, "updated": 1, "link": null, "locked": false, "text": "批次或依赖都可以提前规划；能否立即启动，仍由运行时校验。图中为示例策略，不规定唯一执行顺序。", "originalText": "批次或依赖都可以提前规划；能否立即启动，仍由运行时校验。图中为示例策略，不规定唯一执行顺序。", "fontSize": 17, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "containerId": null, "lineHeight": 1.4, "autoResize": true}], "appState": {"viewBackgroundColor": "#ffffff", "gridSize": null}, "files": {}}